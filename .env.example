# ==============================================================================
# HỆ THỐNG PHÂN LOẠI ĐƠN HÀNG - SPX KHO MEGA SOC PHÙ CHẨN (BẮC NINH)
# File cấu hình mẫu môi trường (.env)
# ==============================================================================

# --- CƠ SỞ DỮ LIỆU (DATABASE) ---
# 1. Để chạy PostgreSQL trên Cloud (Supabase, Neon.tech - Chuyên nghiệp khi bảo vệ):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. Để chạy SQLite local offline (Mặc định):
DATABASE_URL=sqlite:///./warehouse.db

# --- SERVER CẤU HÌNH ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
DEBUG=True

# --- THÔNG TIN KHO TỔNG NGUỒN ---
ORIGIN_HUB_NAME=KHO TỔNG SPX MEGA SOC PHÙ CHẨN
ORIGIN_HUB_ADDRESS=Số 6 Đường số 5, KCN VSIP, Phường Phù Chẩn, TP. Từ Sơn, Tỉnh Bắc Ninh
ORIGIN_HUB_PHONE=1900 1221
ORIGIN_ROUTING_PREFIX=BN-PC01
